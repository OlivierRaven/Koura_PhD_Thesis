                        c(45, 124, 13.5, 83, 78.5, 33.5, 27.5, 32, 87.5, 125, 18, 15.8), 2), 
  `Elevation (m)` = c(280, 279, 295, 316, 305, 355, 355, 395, 305, 340, 280, NA),
