                extensions = 'Buttons') |>
    DT::formatRound(columns = c("Estimate", "Std..Error", "t.value", "Pr...t.."), digits = 3)
} else {
  knitr::kable(feed_tbl, col.names = col_nms_f, digits = 3)
}
```



