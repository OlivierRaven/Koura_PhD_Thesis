  `Perimeter length (km)` = c(45, 61, 40, 24, 29, 11, 5, 16, 48, 27, 2, 25),
  `Catchment area (km²)` = c(508, 123.7, 49.2, 27.8, 59.8, 19.6, 6.2, 18.7, 143.1, 83.3, 3.9, 37),
