  `Trophic state` = c("Eutrophic", "Mesotrophic", "Eutrophic", "Oligotrophic", "Oligotrophic", "Mesotrophic", "Oligotrophic", "Mesotrophic", "Oligotrophic", "Mesotrophic", "Eutrophic", "Eutrophic"),

  check.names = FALSE
